<%- include('../partials/header', { title }) %>

<div class="form-card">
  <h1>Upload HTML document</h1>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <form method="POST" action="/dashboard/documents" enctype="multipart/form-data">
    <label for="file">HTML file</label>
    <input type="file" id="file" name="file" accept=".html,.htm,text/html" required>

    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= form.title || '' %>" required>

    <label for="slug">Slug (goes in the URL: yoursite.com/<em>slug</em>)</label>
    <input type="text" id="slug" name="slug" value="<%= form.slug || '' %>" placeholder="e.g. q1-report" data-slug-source="title" required>
    <p class="hint">Lowercase letters, numbers, and hyphens only.</p>

    <label for="folderId">Folder</label>
    <select id="folderId" name="folderId">
      <option value="">Uncategorized</option>
      <% folders.forEach(function(f) { %>
        <option value="<%= f.id %>" <%= String(form.folderId) === String(f.id) ? 'selected' : '' %>><%= f.name %></option>
      <% }) %>
    </select>

    <label for="password">Viewer password (optional)</label>
    <input type="password" id="password" name="password" placeholder="Leave blank for no password" autocomplete="new-password">

    <label for="expiresAt">Expiry date (optional)</label>
    <input type="date" id="expiresAt" name="expiresAt" value="<%= form.expiresAt || '' %>">
    <p class="hint">Document becomes inaccessible after this date. Leave blank to never expire.</p>

    <div class="form-actions">
      <a href="/dashboard" class="btn btn-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary">Upload</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
<script src="/static/js/dashboard.js"></script>
