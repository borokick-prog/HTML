# Port the server listens on
PORT=3000

# Secret used to sign session cookies. Set this to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "true" only if the app is served over HTTPS (directly or behind a
# proxy that terminates TLS and is trusted). Enables the Secure cookie flag.
TRUST_SECURE_COOKIE=false
