# Port the server listens on (ignored on Vercel)
PORT=3000

# Postgres connection string. Works with Neon, Supabase, Railway, Vercel
# Postgres, or a local Postgres install. Use the *pooled* connection string
# if your provider offers one (e.g. Neon/Supabase "Transaction pooler" URL).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Secret used to sign session cookies. Set this to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to "true" only if the app is served over HTTPS (directly or behind a
# proxy that terminates TLS and is trusted). Enables the Secure cookie flag.
# Not needed on Vercel — it's detected automatically there.
TRUST_SECURE_COOKIE=false
